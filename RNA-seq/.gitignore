# Large input matrices — obtain from Zenodo (see data/README.md)
data/RNAseq_rawcounts.tsv
data/RNAseq_CPM.tsv
data/multiqc_data/
data/*.bam
data/*.fq.gz
data/*.fastq.gz

# Panel objects passed between the analysis scripts and 04_figures/. They are
# serialised R objects, regenerated by run_all.sh, and tied to the R version
# that wrote them — the figures they produce are what belongs in the deposit.
results/**/figure2_panel*.rds

# results/ is deliberately NOT ignored: the figures and tables it holds are
# what the descriptor reports, and shipping them lets a reader check the code
# against its output without an R installation. Regenerate with run_all.sh.

# R / editor cruft
.Rhistory
.RData
.Rproj.user/
*.Rproj
.DS_Store
