    title: "Multi-omics analyses of tomato rhizosphere and leaves treated with a biowaste-derived biostimulant extract"
    doi: "10.5281/zenodo.19336337"
  - type: dataset
    title: "Raw sequencing data, NCBI SRA"
    identifiers:
      - type: other
        value: "PRJNA1425279"
